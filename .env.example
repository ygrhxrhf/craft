# Copy this file to `.env` and fill in real values. Generate each secret with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.

# Connection string for PostgreSQL (>= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/crafty"

# NextAuth session signing. No built-in fallback: the app refuses to start
# routes that sign or verify tokens when this is missing or shorter than 32 chars.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# HMAC key for collaboration tokens (Next app <-> src/collab/server.mjs).
# Both sides read COLLAB_SECRET first, then AUTH_SECRET/NEXTAUTH_SECRET.
COLLAB_SECRET=""

# Shared secret between Next.js and the whiteboard sync service. Guards the
# /api/internal/** snapshot and collab-state endpoints.
TLDRAW_INTERNAL_SECRET=""

# Whiteboard sync WebSocket port / public URL.
TLDRAW_SYNC_PORT="3002"
NEXT_PUBLIC_TLDRAW_SYNC_URL="ws://localhost:3002"

# Document collaboration server port / public URL.
COLLAB_PORT="3001"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:3001"

# 前端根地址（编译期注入，改后需重建镜像）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 附件存储驱动：local（默认）| cos（生产私有桶 + 预签名，spec 7.1）
STORAGE_DRIVER="local"
# 桶名需先创建（阶段 B Task 4.3 / 7.1）。地域必须与环境一致：
# 环境 aaa11-d1gfgozz987c564a5 在 ap-shanghai，跨地域会拖慢预签名直传且与 VpcConf 不同域。
COS_BUCKET=""
COS_REGION="ap-shanghai"
COS_SECRET_ID=""
COS_SECRET_KEY=""
# 可选：COS 自定义域名/CDN、releases 桶（Tauri 更新源，需公有读或挂 CDN）
# COS_DOMAIN="https://attachments.example.com"
# COS_RELEASES_BUCKET=""

# OpenAI,用于 AI 文本改写与图像生成
OPENAI_API_KEY=""
# 可选,文本模型,默认 gpt-4o-mini
OPENAI_MODEL=""
# 可选,图像模型,默认 gpt-image-1
OPENAI_IMAGE_MODEL=""

# 可选：插入面板「插入 Unsplash 图片」。不配则那一格保持禁用占位（/api/unsplash/search 回 501）。
UNSPLASH_ACCESS_KEY=""
# 可选：接入中心「所有文档的 MCP」的令牌签名密钥。不配则回退到 AUTH_SECRET/NEXTAUTH_SECRET。
MCP_SIGNING_SECRET=""
