      {
        "description": "create table \"notifications\"",
        "sql": "CREATE TABLE \"public\".\"notifications\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"documentId\" text,\n  \"id\" text NOT NULL,\n  \"isResolved\" bool DEFAULT false NOT NULL,\n  \"kind\" text DEFAULT 'taskReminder' NOT NULL,\n  \"remindAt\" timestamptz,\n  \"resolvedAt\" timestamptz,\n  \"taskId\" text,\n  \"title\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
