// Crafty — Craft.do 1:1 Clone Database Schema (Prisma 8)

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  image         String?
  theme         String    @default("system")
  editorFont    String    @default("inter")
  editorWidth   String    @default("default")
  notifyComments   Boolean @default(true)
  notifyReminders  Boolean @default(true)
  notifyDaily      Boolean @default(true)
  // G160：已完成任务的外观三档（官方 preferences.advanced.completed.task.appearance.*＝淡化/删除线/无）
  completedTaskAppearance String @default("strike") // "faded" | "strike" | "none"
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  documents     Document[]
  folders       Folder[]
  favorites     Favorite[]
  tags          Tag[]
  collections   Collection[]
  whiteboards   Whiteboard[]
  dailyNotesConfig DailyNotesConfig?
  tasks         Task[]
  documentMembers DocumentMember[]
  notifications Notification[]
  connections   Connection[]

  @@map("users")
}

model Folder {
  id        String    @id @default(uuid())
  name      String    @default("未命名文件夹")
  icon      String?
  order     Float     @default(0)
  parentId  String?
  userId    String
  isDeleted Boolean   @default(false)
  deletedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // G233：同一类缺陷的第三处——文件夹树自引用也是 NO ACTION，`purgeTombstones` 30 天后
  // 硬删文件夹时若子文件夹还在就会撞 FK。与 documents.parentId 同档：删父时子项提升到根。
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderTree")
  documents Document[]
  collections Collection[]
  whiteboards Whiteboard[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model Document {
  id            String    @id @default(uuid())
  title         String    @default("无标题")
  icon          String?
  coverImage    String?
  coverType     String?
  content       Json?
  plainText     String    @default("")
  order         Float     @default(0)

  parentId      String?
  folderId      String?
  userId        String

  font          String?
  width         String?
  pageStyle     Json?

  isTemplate    Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     TimestamptzString?

  isDailyNote   Boolean   @default(false)
  dailyNoteDate TimestamptzString?

  // G610：官方 `document_view` 会把"上次浏览"并进文档对象；列表档「上次浏览」列读它。
  lastViewedAt  TimestamptzString?

  wordCount     Int       @default(0)
  charCount     Int       @default(0)

  version       Int       @default(1)

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  metaUpdatedAt TimestamptzString?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // G233：自引用 FK 此前是 NO ACTION ⇒ 任何有子文档的文档都无法物理删除
  // （`permanentDeleteDocument` 与「清空最近删除」都会撞 FK）。与 `folderId` 同档：
  // 永久删除父文档时把子文档提升到根，而不是连坐删掉它们。
  parent        Document? @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Document[] @relation("DocumentTree")
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  favorites     Favorite[]
  tags          DocumentTag[]
  backlinks     Backlink[] @relation("LinkedDocument")
  linkingDocs   Backlink[] @relation("SourceDocument")
  versions      DocumentVersion[]
  tasks         Task[]
  shares        DocumentShare[]
  members       DocumentMember[]
  collabState   YjsDocumentState?
  notifications Notification[]

  @@index([userId])
  @@index([folderId])
  @@index([parentId])
  @@index([isDeleted])
  @@index([isDailyNote, dailyNoteDate])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int
  title       String
  content     Json
  plainText   String   @default("")
  wordCount   Int      @default(0)
  /// 样式快照（icon/coverImage/coverType/width/pageStyle）。历史行没有这一列，故可空。
  meta        Json?
  createdAt   TimestamptzString @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model Collection {
  id          String   @id @default(uuid())
  name        String   @default("未命名集合")
  icon        String?
  description String?
  order       Float    @default(0)
  folderId    String?
  userId      String
  isDeleted   Boolean  @default(false)
  deletedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  properties  CollectionProperty[]
  items       CollectionItem[]
  views       CollectionView[]

  @@index([userId])
  @@index([folderId])
  @@map("collections")
}

model CollectionProperty {
  id           String   @id @default(uuid())
  collectionId String
  name         String
  type         String
  config       Json?
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  width        Int?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  values       CollectionValue[]

  @@index([collectionId])
  @@map("collection_properties")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  order        Float    @default(0)
  documentId   String?
  // G427/G428：一个记录对象可同时属于多个集合——官方 `objectData.schemas` 是数组，
  //   `collectionId` 保留为"主集合"（读侧排序与既有路径不变），`schemas` 记全部归属。
  //   删集合只从 `schemas` 里摘一项，对象本身不动（与「删组只清该字段的值、不删行」同一条原则）。
  schemas      Json?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // G233：与 documents.parentId 同一类缺陷——可空自引用/外键用了 NO ACTION，
  // 于是永久删除一篇被收进集合的文档会撞 FK。删文档时把集合行留成"无宿主"（值仍在，靠 deletedAt 收口）。
  document     Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  values       CollectionValue[]

  @@index([collectionId])
  @@map("collection_items")
}

model CollectionValue {
  id           String   @id @default(uuid())
  itemId       String
  propertyId   String
  value        Json?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  item         CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  property     CollectionProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([itemId, propertyId])
  @@map("collection_values")
}

model CollectionView {
  id           String   @id @default(uuid())
  collectionId String
  name         String   @default("默认视图")
  type         String
  config       Json?
  isActive     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("collection_views")
}

model Whiteboard {
  id          String   @id @default(uuid())
  name        String   @default("未命名白板")
  icon        String?
  data        Json?
  order       Float    @default(0)
  folderId    String?
  userId      String
  isDeleted   Boolean  @default(false)
  deletedAt   TimestamptzString?

  sharePermission String  @default("off") // "off" | "view" | "edit"
  shareToken      String? @unique
  shareVersion    Int     @default(0)

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  metaUpdatedAt TimestamptzString?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@map("whiteboards")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  userId    String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  deletedAt TimestamptzString?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DocumentTag[]

  @@unique([name, userId])
  @@map("tags")
}

model DocumentTag {
  documentId String
  tagId      String
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  deletedAt  TimestamptzString?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([documentId, tagId])
  @@map("document_tags")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  order      Float    @default(0)
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  deletedAt  TimestamptzString?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("favorites")
}

model Backlink {
  id               String   @id @default(uuid())
  sourceDocumentId String
  linkedDocumentId String
  sourceBlockId    String?
  createdAt        TimestamptzString @default(now())

  sourceDocument   Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  linkedDocument   Document @relation("LinkedDocument", fields: [linkedDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, linkedDocumentId])
  @@map("backlinks")
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  documentId  String?
  blockId     String?
  title       String
  isCompleted Boolean  @default(false)
  dueDate     TimestamptzString?
  // G15: schedule（计划哪天做）与 deadline（dueDate，最晚必须完成）是两套独立属性。
  scheduleDate TimestamptzString?
  remindAt    TimestamptzString?
  recurrence  String?
  recurrenceEnd TimestamptzString?
  completedAt TimestamptzString?
  // 官方取消与完成各记一个时间戳（`tasks.canceled.on`／`tasks.completed.on`＝tasks.md:104）
  cancelledAt TimestamptzString?
  status      String   @default("todo") // "todo" | "doing" | "done" | "cancelled"
  order       Float    @default(0)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  deletedAt   TimestamptzString?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@index([documentId, blockId])
  @@map("tasks")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  kind        String   @default("taskReminder") // "taskReminder"
  taskId      String?
  documentId  String?
  title       String
  remindAt    TimestamptzString?
  // G137: read and resolved are different axes — a notification can be read but not dismissed,
  // and marking it unread again must be possible.
  readAt      TimestamptzString?
  isResolved  Boolean  @default(false)
  resolvedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([taskId, remindAt])
  @@index([userId, isResolved])
  @@map("notifications")
}

model DocumentShare {
  id           String   @id @default(uuid())
  documentId   String
  token        String   @unique
  slug         String?  @unique
  passcode     String?
  isPublished  Boolean  @default(false)
  permission   String   @default("view") // "view" | "edit"
  // G38：发布页「显示作者」（官方 showAuthor 默认 true）——只影响公开页渲不渲染作者署名。
  showAuthor   Boolean  @default(true)
  // G1534：visual.options 其余四组（官方默认值见 publishing.md:17 的 Pa 表）。
  showPageTitle        Boolean @default(true)  // 显示标题（hideTableOfContents 的兄弟档）
  hideTableOfContents  Boolean @default(false) // 显示目录
  hidePresentationMode Boolean @default(false) // 显示演示模式
  showWatermark        Boolean @default(true)  // 显示"Created With Craft"页脚
  // G143/G1535：链接到期是独立一轴（官方 expiration.date / expire.on / expire.never）。
  expiresAt            TimestamptzString?
  // G143/G85：搜索引擎索引（官方 enableSeo 默认 false；与口令保护互斥，口令一设即失效）。
  enableSeo            Boolean @default(false)
  // G141: the remaining publish-settings fields of the official 13. Defaults are the official ones.
  commentLevel             String  @default("add") // "add" | "view" | "none"
  enableObjectLinks        Boolean @default(false)
  showDuplicateAsTemplate  Boolean @default(false)
  emailBasedAccessEnabled  Boolean @default(false)
  hideHashTagWords         Boolean @default(false)
  defaultDomain            String? // null = unset (the official default is `undefined`)
  shareVersion Int      @default(0)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_shares")
}

model DailyNotesConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  folderId    String?
  templateId  String?
  startTime   String   @default("00:00")
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_notes_config")
}

model CommentThread {
  id           String   @id @default(uuid())
  documentId   String
  blockId      String?
  blockText    String   @default("")
  resolved     Boolean  @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments     Comment[]

  @@index([documentId, resolved])
  @@map("comment_threads")
}

model Comment {
  id         String   @id @default(uuid())
  threadId   String
  userId     String
  body       String
  // JSON list of {glyph, userId, name}. Absent on every comment written before reactions existed.
  reactions  Json?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
  deletedAt  TimestamptzString?

  thread     CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("comments")
}

model DocumentMember {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  role       String   @default("editor") // "editor" | "commenter" | "viewer" | "requested"（待批准的编辑请求，不授予权限）
  addedBy    String?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_members")
}

// G21/G44: the local MCP/API access centre. This build stores the connection
// descriptor only; it does not speak either protocol yet.
model Connection {
  id        String   @id @default(uuid())
  userId    String
  kind      String   @default("mcp") // "mcp" | "api"
  name      String
  endpoint  String   @default("")
  token     String?
  // G122: the three axes of the access centre — permission / protection / scope. Stored as their
  // enum strings; the defaults match the official ones (read-write / public / all documents).
  permission String  @default("read-write") // "read-only" | "write-only" | "read-write"
  protection String  @default("public")     // "public" | "key" | "password"
  scope      String  @default("all-documents") // "all-documents" | "selected-documents" | "daily-notes-and-tasks"
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("connections")
}

// Binary Yjs room state, authoritative while a Hocuspocus room is live.
// `Document.content` stays the dehydrated projection for rendering/search/export.
model YjsDocumentState {
  id         String   @id @default(uuid())
  documentId String   @unique
  state      Bytes
  bytes      Int      @default(0)
  updatedAt  temporal.updatedAtString()

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("yjs_document_states")
}

model SyncEvent {
  id     Int    @id @default(autoincrement())
  ts     TimestamptzString @default(now())
  tables String[]
  cursor String
  userId String

  @@index([userId])
  @@map("sync_events")
}
